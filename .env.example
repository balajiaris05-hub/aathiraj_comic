# ============================================================================
# AATHIRAI_COMIC — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env and configure your keys. Never commit real secrets.

PORT=3000
NODE_ENV=development

# Backend Session Token Signing Secret (HMAC-SHA256)
SESSION_SECRET=replace_with_64_char_random_hex_secret

# ----------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (INR — UPI / Cards / NetBanking / Wallets)
# ----------------------------------------------------------------------------
# Modes determined automatically by server:
# 1. UNCONFIGURED: Leave blank -> Checkout is disabled with a clear status notice
# 2. TEST MODE:    Use rzp_test_* -> Enables TEST mode with prominent test banner
# 3. LIVE MODE:    Use rzp_live_* -> Enables real INR payments via window.Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# EMAIL / SMS OTP DELIVERY PROVIDERS (Optional in Dev)
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS OTP Providers (Optional — choose Fast2SMS for India ₹50 free trial, Twilio for Global free trial, or Textbelt)
SMS_PROVIDER=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TEXTBELT_API_KEY=
SMS_API_KEY=

# ----------------------------------------------------------------------------
# FIREBASE CLOUD FIRESTORE SERVER BRIDGE (aathiraicomic)
# ----------------------------------------------------------------------------
# Optional JSON string (or file path via FIREBASE_SERVICE_ACCOUNT_PATH) of a
# Firebase Service Account key for unattended server-side Firestore REST writes
# (e.g. Razorpay webhooks). Logged-in clients also persist directly via Firebase SDK
# and Firebase Auth ID token pass-through.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

