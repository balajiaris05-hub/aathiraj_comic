# ============================================================================
# AATHIRAI_COMIC — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env and configure your keys. Never commit real secrets.

PORT=3000
NODE_ENV=development

# Backend Session Token Signing Secret (HMAC-SHA256)
SESSION_SECRET=replace_with_64_char_random_hex_secret

# ----------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (INR — UPI / Cards / NetBanking / Wallets)
# ----------------------------------------------------------------------------
# Modes determined automatically by server:
# 1. UNCONFIGURED: Leave blank -> Checkout is disabled with a clear status notice
# 2. TEST MODE:    Use rzp_test_* -> Enables TEST mode with prominent test banner
# 3. LIVE MODE:    Use rzp_live_* -> Enables real INR payments via window.Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# EMAIL / SMS OTP DELIVERY PROVIDERS (Optional in Dev)
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_API_KEY=
