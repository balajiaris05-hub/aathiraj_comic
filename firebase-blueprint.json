        "fullUnlockPriceInr": {
          "type": "number",
          "description": "Full unlock price in INR."
        },
        "status": {
          "type": "string",
          "description": "Publication status.",
          "enum": ["pending", "published", "rejected"],
          "minLength": 7,
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "comicId",
        "title",
        "authorId",
        "authorName",
        "genre",
        "accessType",
        "fullUnlockPriceInr",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
