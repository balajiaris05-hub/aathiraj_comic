{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "adminId": {
          "type": "string",
          "description": "Firebase UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email address.",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin record was created."
        }
      },
      "required": ["adminId", "email", "createdAt"]
    },
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public non-PII reader or author profile.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the reader or author.",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Immutable role assigned on creation.",
          "enum": ["reader", "author", "admin"],
          "minLength": 4,
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["userId", "name", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII, Gmail, Mobile, UPI ID, Age, and Paid Detail of Premium for a reader.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer Gmail address.",
          "minLength": 3,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Customer mobile phone number.",
          "minLength": 3,
          "maxLength": 32
        },
        "upiId": {
          "type": "string",
          "description": "Customer UPI ID / VPA stored in database.",
          "minLength": 3,
          "maxLength": 100
        },
        "age": {
          "type": "number",
          "description": "Customer age in years (5 to 110)."
        },
        "premiumPlan": {
          "type": "string",
          "description": "Paid Premium plan tier.",
          "enum": ["free", "1_month", "6_months"],
          "minLength": 4,
          "maxLength": 16
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment mode used (e.g., UPI, Razorpay).",
          "minLength": 2,
          "maxLength": 80
        },
        "transactionId": {
          "type": "string",
          "description": "UPI or payment reference ID.",
          "minLength": 2,
          "maxLength": 80
        },
        "amountPaidInr": {
          "type": "number",
          "description": "Amount paid in INR (0, 49, or 249)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "userId",
        "email",
        "phone",
        "upiId",
        "age",
        "premiumPlan",
        "paymentMethod",
        "transactionId",
        "amountPaidInr",
        "createdAt",
        "updatedAt"
      ]
    },
    "ComicRecord": {
      "title": "ComicRecord",
      "description": "Comic series metadata stored in Firestore.",
      "type": "object",
      "properties": {
        "comicId": {
          "type": "string",
          "description": "Unique comic identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Comic series title.",
          "minLength": 1,
          "maxLength": 140
        },
        "authorId": {
          "type": "string",
          "description": "Creator UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Creator display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "genre": {
          "type": "string",
          "description": "Primary comic genre.",
          "minLength": 1,
          "maxLength": 50
