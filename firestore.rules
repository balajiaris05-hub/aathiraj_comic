rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRIMITIVE HELPERS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'balajiaris05@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // ENTITY VALIDATION BLUEPRINTS
    // =========================================================================

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['adminId', 'email', 'createdAt']) &&
        data.keys().hasOnly(['adminId', 'email', 'createdAt']) &&
        data.adminId is string && data.adminId.size() >= 1 && data.adminId.size() <= 128 && data.adminId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['userId', 'name', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'name', 'role', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.role is string && data.role.size() >= 4 && data.role.size() <= 16 &&
        (data.role == 'reader' || data.role == 'author' || data.role == 'admin') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll([
          'userId', 'email', 'phone', 'upiId', 'age',
          'premiumPlan', 'paymentMethod', 'transactionId', 'amountPaidInr',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'email', 'phone', 'upiId', 'age',
          'premiumPlan', 'paymentMethod', 'transactionId', 'amountPaidInr',
          'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 32 &&
        data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 100 &&
        data.age is number && data.age >= 5 && data.age <= 110 &&
        data.premiumPlan is string && data.premiumPlan.size() >= 4 && data.premiumPlan.size() <= 16 &&
        (data.premiumPlan == 'free' || data.premiumPlan == '1_month' || data.premiumPlan == '6_months') &&
        data.paymentMethod is string && data.paymentMethod.size() >= 2 && data.paymentMethod.size() <= 80 &&
        data.transactionId is string && data.transactionId.size() >= 2 && data.transactionId.size() <= 80 &&
        data.amountPaidInr is number && (data.amountPaidInr == 0 || data.amountPaidInr == 49 || data.amountPaidInr == 249) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidComicRecord(data) {
      return data.keys().hasAll([
          'comicId', 'title', 'authorId', 'authorName', 'genre',
          'accessType', 'fullUnlockPriceInr', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'comicId', 'title', 'authorId', 'authorName', 'genre',
          'accessType', 'fullUnlockPriceInr', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.comicId is string && data.comicId.size() >= 1 && data.comicId.size() <= 128 && data.comicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 50 &&
        data.accessType is string && data.accessType.size() >= 4 && data.accessType.size() <= 16 &&
        (data.accessType == 'free' || data.accessType == 'premium') &&
        data.fullUnlockPriceInr is number && data.fullUnlockPriceInr >= 0 && data.fullUnlockPriceInr <= 10000 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 16 &&
        (data.status == 'pending' || data.status == 'published' || data.status == 'rejected') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEpisodeRecord(data) {
      return data.keys().hasAll([
          'episodeId', 'comicId', 'chapterId', 'chapterNumber', 'chapterTitle',
          'episodeNumber', 'title', 'authorId', 'isPremium', 'priceInr',
          'pagesCount', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'episodeId', 'comicId', 'chapterId', 'chapterNumber', 'chapterTitle',
          'episodeNumber', 'title', 'authorId', 'isPremium', 'priceInr',
          'pagesCount', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.episodeId is string && data.episodeId.size() >= 1 && data.episodeId.size() <= 128 && data.episodeId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.comicId is string && data.comicId.size() >= 1 && data.comicId.size() <= 128 && data.comicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.chapterId is string && data.chapterId.size() >= 1 && data.chapterId.size() <= 128 && data.chapterId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.chapterNumber is number && data.chapterNumber >= 1 && data.chapterNumber <= 5000 &&
        data.chapterTitle is string && data.chapterTitle.size() >= 1 && data.chapterTitle.size() <= 140 &&
        data.episodeNumber is number && data.episodeNumber >= 1 && data.episodeNumber <= 10000 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.isPremium is bool &&
        data.priceInr is number && data.priceInr >= 0 && data.priceInr <= 10000 &&
        data.pagesCount is number && data.pagesCount >= 0 && data.pagesCount <= 500 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 16 &&
        (data.status == 'pending' || data.status == 'published' || data.status == 'rejected') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCommentRecord(data) {
      return data.keys().hasAll([
          'commentId', 'comicId', 'episodeId', 'userId', 'userName',
          'content', 'likesCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'commentId', 'comicId', 'episodeId', 'userId', 'userName',
          'content', 'likesCount', 'createdAt', 'updatedAt'
        ]) &&
        data.commentId is string && data.commentId.size() >= 1 && data.commentId.size() <= 128 && data.commentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.comicId is string && data.comicId.size() >= 1 && data.comicId.size() <= 128 && data.comicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.episodeId is string && data.episodeId.size() >= 1 && data.episodeId.size() <= 128 && data.episodeId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
        data.likesCount is number && data.likesCount >= 0 && data.likesCount <= 1000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRatingRecord(data) {
      return data.keys().hasAll(['ratingId', 'comicId', 'episodeId', 'userId', 'stars', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ratingId', 'comicId', 'episodeId', 'userId', 'stars', 'createdAt', 'updatedAt']) &&
        data.ratingId is string && data.ratingId.size() >= 1 && data.ratingId.size() <= 128 && data.ratingId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.comicId is string && data.comicId.size() >= 1 && data.comicId.size() <= 128 && data.comicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.episodeId is string && data.episodeId.size() >= 1 && data.episodeId.size() <= 128 && data.episodeId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.stars is number && data.stars >= 1 && data.stars <= 5 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVoteRecord(data) {
      return data.keys().hasAll(['voteId', 'comicId', 'episodeId', 'userId', 'voteType', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['voteId', 'comicId', 'episodeId', 'userId', 'voteType', 'createdAt', 'updatedAt']) &&
        data.voteId is string && data.voteId.size() >= 1 && data.voteId.size() <= 128 && data.voteId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.comicId is string && data.comicId.size() >= 1 && data.comicId.size() <= 128 && data.comicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.episodeId is string && data.episodeId.size() >= 1 && data.episodeId.size() <= 128 && data.episodeId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.voteType is string && data.voteType.size() >= 4 && data.voteType.size() <= 16 &&
        (data.voteType == 'like' || data.voteType == 'dislike') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPurchaseRecord(data) {
      return data.keys().hasAll([
          'purchaseId', 'userId', 'comicId', 'itemTitle', 'planType',
          'amountInr', 'upiId', 'paymentMethod', 'receiptNumber', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'purchaseId', 'userId', 'comicId', 'itemTitle', 'planType',
          'amountInr', 'upiId', 'paymentMethod', 'receiptNumber', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.purchaseId is string && data.purchaseId.size() >= 1 && data.purchaseId.size() <= 128 && data.purchaseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.comicId is string && data.comicId.size() >= 1 && data.comicId.size() <= 128 && data.comicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.itemTitle is string && data.itemTitle.size() >= 1 && data.itemTitle.size() <= 140 &&
        data.planType is string && data.planType.size() >= 7 && data.planType.size() <= 16 &&
        (data.planType == '1_month' || data.planType == '6_months' || data.planType == 'episode' || data.planType == 'chapter' || data.planType == 'full_comic') &&
        data.amountInr is number && data.amountInr >= 1 && data.amountInr <= 50000 &&
        data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 100 &&
        data.paymentMethod is string && data.paymentMethod.size() >= 2 && data.paymentMethod.size() <= 80 &&
        data.receiptNumber is string && data.receiptNumber.size() >= 3 && data.receiptNumber.size() <= 64 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 16 &&
        (data.status == 'success' || data.status == 'refunded') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotificationRecord(data) {
      return data.keys().hasAll([
          'notificationId', 'userId', 'type', 'title', 'message',
          'targetId', 'isPaywalled', 'read', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'notificationId', 'userId', 'type', 'title', 'message',
          'targetId', 'isPaywalled', 'read', 'createdAt', 'updatedAt'
        ]) &&
        data.notificationId is string && data.notificationId.size() >= 1 && data.notificationId.size() <= 128 && data.notificationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.type is string && data.type.size() >= 5 && data.type.size() <= 32 &&
        (data.type == 'new_comic' || data.type == 'new_episode' || data.type == 'payment_success' || data.type == 'author_approved' || data.type == 'author_rejected' || data.type == 'comic_approved' || data.type == 'comic_rejected' || data.type == 'comment_reply' || data.type == 'system') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.isPaywalled is bool &&
        data.read is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuthorApplicationRecord(data) {
      return data.keys().hasAll([
          'applicationId', 'userId', 'penName', 'bio', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'applicationId', 'userId', 'penName', 'bio', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.applicationId is string && data.applicationId.size() >= 1 && data.applicationId.size() <= 128 && data.applicationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.penName is string && data.penName.size() >= 1 && data.penName.size() <= 80 &&
        data.bio is string && data.bio.size() >= 3 && data.bio.size() <= 600 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 16 &&
        (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDeleteRequestRecord(data) {
      return data.keys().hasAll([
          'requestId', 'comicId', 'comicTitle', 'targetType',
          'authorId', 'authorName', 'reason', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'requestId', 'comicId', 'comicTitle', 'targetType',
          'authorId', 'authorName', 'reason', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.requestId is string && data.requestId.size() >= 1 && data.requestId.size() <= 128 && data.requestId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.comicId is string && data.comicId.size() >= 1 && data.comicId.size() <= 128 && data.comicId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.comicTitle is string && data.comicTitle.size() >= 1 && data.comicTitle.size() <= 140 &&
        data.targetType is string && data.targetType.size() >= 6 && data.targetType.size() <= 16 &&
        (data.targetType == 'series' || data.targetType == 'chapter' || data.targetType == 'episode') &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 16 &&
        (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidContentReportRecord(data) {
      return data.keys().hasAll([
          'reportId', 'reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'reportId', 'reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.reportId is string && data.reportId.size() >= 1 && data.reportId.size() <= 128 && data.reportId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 && data.reporterId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.targetType is string && data.targetType.size() >= 5 && data.targetType.size() <= 16 &&
        (data.targetType == 'comment' || data.targetType == 'comic' || data.targetType == 'episode') &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 && data.targetId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 300 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 16 &&
        (data.status == 'pending' || data.status == 'resolved' || data.status == 'dismissed') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGstSettingsRecord(data) {
      return data.keys().hasAll([
          'settingId', 'legalBusinessName', 'tradeName', 'gstin',
          'stateCode', 'stateName', 'registeredAddress', 'invoicePrefix',
          'defaultSacCode', 'applicableGstRate', 'updatedByEmail',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'settingId', 'legalBusinessName', 'tradeName', 'gstin',
          'stateCode', 'stateName', 'registeredAddress', 'invoicePrefix',
          'defaultSacCode', 'applicableGstRate', 'updatedByEmail',
          'createdAt', 'updatedAt'
        ]) &&
        data.settingId is string && data.settingId.size() >= 1 && data.settingId.size() <= 128 && data.settingId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.legalBusinessName is string && data.legalBusinessName.size() >= 2 && data.legalBusinessName.size() <= 140 &&
        data.tradeName is string && data.tradeName.size() >= 1 && data.tradeName.size() <= 100 &&
        data.gstin is string && data.gstin.size() >= 0 && data.gstin.size() <= 15 &&
        (data.gstin.size() == 0 || data.gstin.matches('^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$')) &&
        data.stateCode is string && data.stateCode.size() == 2 &&
        data.stateName is string && data.stateName.size() >= 2 && data.stateName.size() <= 80 &&
        data.registeredAddress is string && data.registeredAddress.size() >= 3 && data.registeredAddress.size() <= 300 &&
        data.invoicePrefix is string && data.invoicePrefix.size() >= 1 && data.invoicePrefix.size() <= 12 &&
        data.defaultSacCode is string && data.defaultSacCode.size() >= 4 && data.defaultSacCode.size() <= 10 &&
        data.applicableGstRate is number && data.applicableGstRate >= 0 && data.applicableGstRate <= 28 &&
        data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPlatformSettingsRecord(data) {
      return data.keys().hasAll([
          'settingId', 'merchantUpiId', 'merchantUpiName',
          'razorpay1MonthUrl', 'razorpay6MonthsUrl', 'updatedByEmail',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'settingId', 'merchantUpiId', 'merchantUpiName',
          'razorpay1MonthUrl', 'razorpay6MonthsUrl', 'updatedByEmail',
          'createdAt', 'updatedAt'
        ]) &&
        data.settingId is string && data.settingId.size() >= 1 && data.settingId.size() <= 128 && data.settingId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.merchantUpiId is string && data.merchantUpiId.size() >= 3 && data.merchantUpiId.size() <= 100 &&
        data.merchantUpiName is string && data.merchantUpiName.size() >= 2 && data.merchantUpiName.size() <= 100 &&
        data.razorpay1MonthUrl is string && data.razorpay1MonthUrl.size() >= 8 && data.razorpay1MonthUrl.size() <= 200 &&
        data.razorpay6MonthsUrl is string && data.razorpay6MonthsUrl.size() >= 8 && data.razorpay6MonthsUrl.size() <= 200 &&
        data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdRequestRecord(data) {
      return data.keys().hasAll([
          'requestId', 'companyName', 'contactName', 'contactEmail', 'contactPhone',
          'placementType', 'targetComicTitle', 'budgetRange', 'description',
          'status', 'submittedByUserId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'requestId', 'companyName', 'contactName', 'contactEmail', 'contactPhone',
          'placementType', 'targetComicTitle', 'budgetRange', 'description',
          'status', 'submittedByUserId', 'createdAt', 'updatedAt'
        ]) &&
        data.requestId is string && data.requestId.size() >= 1 && data.requestId.size() <= 128 && data.requestId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120 &&
        data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 80 &&
        data.contactEmail is string && data.contactEmail.size() >= 3 && data.contactEmail.size() <= 120 &&
        data.contactPhone is string && data.contactPhone.size() >= 0 && data.contactPhone.size() <= 32 &&
        data.placementType is string && data.placementType.size() >= 10 && data.placementType.size() <= 32 &&
        (data.placementType == 'character_promotion' || data.placementType == 'sponsored_page' || data.placementType == 'episode_sponsor') &&
        data.targetComicTitle is string && data.targetComicTitle.size() >= 1 && data.targetComicTitle.size() <= 140 &&
        data.budgetRange is string && data.budgetRange.size() >= 1 && data.budgetRange.size() <= 64 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1000 &&
        data.status is string && data.status.size() >= 7 && data.status.size() <= 16 &&
        (data.status == 'pending' || data.status == 'contacted' || data.status == 'approved' || data.status == 'rejected') &&
        data.submittedByUserId is string && data.submittedByUserId.size() >= 1 && data.submittedByUserId.size() <= 128 && data.submittedByUserId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // 1. /admins/{adminId}
    // =========================================================================
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().adminId == adminId &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if isValidAdminRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(adminId) &&
        incoming().adminId == existing().adminId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email']) &&
        isAdmin();
      allow delete: if isVerifiedUser() && isValidId(adminId) && isAdmin();
    }

    // =========================================================================
    // 2. /users/{userId} (Public Non-PII Profile)
    // =========================================================================
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming()) &&
        incoming().userId == userId &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().role == 'reader' || isAdmin());

      allow update: if isValidUserPublicProfile(incoming()) &&
        isVerifiedUser() &&
        isValidId(userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isAdmin();

      // =======================================================================
      // 3. /users/{userId}/private/{infoId} (Strictly Isolated PII, UPI & Plan)
      // =======================================================================
      match /private/{infoId} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(infoId) && (isOwner(userId) || isAdmin()) &&
          get(/databases/$(database)/documents/users/$(userId)).data.userId == userId;
        allow list: if false;

        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(infoId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().userId == userId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isOwner(userId) || isAdmin()) &&
          get(/databases/$(database)/documents/users/$(userId)).data.userId == userId;

        allow update: if isValidUserPrivateInfo(incoming()) &&
          isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(infoId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (isOwner(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'email', 'phone', 'upiId', 'age',
                'premiumPlan', 'paymentMethod', 'transactionId', 'amountPaidInr', 'updatedAt'
              ]) &&
              get(/databases/$(database)/documents/users/$(userId)).data.userId == userId) ||
            (isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'email', 'phone', 'upiId', 'age',
                'premiumPlan', 'paymentMethod', 'transactionId', 'amountPaidInr', 'updatedAt'
              ]))
          );

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(infoId) && isAdmin();
      }
    }

    // =========================================================================
    // 4. /comics/{comicId} & /comics/{comicId}/episodes/{episodeId}
    // =========================================================================
    match /comics/{comicId} {
      allow get: if isValidId(comicId) && (existing().status == 'published' || isOwner(existing().authorId) || isAdmin());
      allow list: if resource.data.status == 'published' || (isVerifiedUser() && resource.data.authorId == request.auth.uid) || isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(comicId) &&
        isValidComicRecord(incoming()) &&
        incoming().comicId == comicId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (incoming().authorId == request.auth.uid || isAdmin()) &&
        exists(/databases/$(database)/documents/users/$(incoming().authorId));

      allow update: if isValidComicRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(comicId) &&
        incoming().comicId == existing().comicId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(existing().authorId) &&
            existing().status == 'pending' &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'genre', 'accessType', 'fullUnlockPriceInr', 'updatedAt'
            ])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'genre', 'accessType', 'fullUnlockPriceInr', 'status', 'updatedAt'
            ]))
        );

      allow delete: if isVerifiedUser() && isValidId(comicId) && isAdmin();

      match /episodes/{episodeId} {
        allow get: if isValidId(comicId) && isValidId(episodeId) &&
          get(/databases/$(database)/documents/comics/$(comicId)).data.comicId == comicId &&
          (existing().status == 'published' || isOwner(existing().authorId) || isAdmin());
        allow list: if resource.data.status == 'published' || (isVerifiedUser() && resource.data.authorId == request.auth.uid) || isAdmin();

        allow create: if isVerifiedUser() &&
          isValidId(comicId) &&
          isValidId(episodeId) &&
          isValidEpisodeRecord(incoming()) &&
          incoming().comicId == comicId &&
          incoming().episodeId == episodeId &&
          (incoming().authorId == request.auth.uid || isAdmin()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/comics/$(comicId)).data.authorId == incoming().authorId;

        allow update: if isValidEpisodeRecord(incoming()) &&
          isVerifiedUser() &&
          isValidId(comicId) &&
          isValidId(episodeId) &&
          incoming().episodeId == existing().episodeId &&
          incoming().comicId == existing().comicId &&
          incoming().authorId == existing().authorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (isOwner(existing().authorId) &&
              existing().status == 'pending' &&
              incoming().status == existing().status &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'chapterId', 'chapterNumber', 'chapterTitle', 'episodeNumber',
                'title', 'isPremium', 'priceInr', 'pagesCount', 'updatedAt'
              ])) ||
            (isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'chapterId', 'chapterNumber', 'chapterTitle', 'episodeNumber',
                'title', 'isPremium', 'priceInr', 'pagesCount', 'status', 'updatedAt'
              ]))
          );

        allow delete: if isVerifiedUser() && isValidId(comicId) && isValidId(episodeId) && isAdmin();
      }
    }

    // =========================================================================
    // 5. /comments/{commentId}
    // =========================================================================
    match /comments/{commentId} {
      allow get: if isValidId(commentId) && existing().likesCount >= 0;
      allow list: if resource.data.likesCount >= 0;

      allow create: if isVerifiedUser() &&
        isValidId(commentId) &&
        isValidCommentRecord(incoming()) &&
        incoming().commentId == commentId &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        incoming().likesCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/comics/$(incoming().comicId)) &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isValidCommentRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(commentId) &&
        incoming().commentId == existing().commentId &&
        incoming().comicId == existing().comicId &&
        incoming().episodeId == existing().episodeId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(existing().userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['content', 'likesCount', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(commentId) && (isOwner(existing().userId) || isAdmin());
    }

    // =========================================================================
    // 6. /ratings/{ratingId}
    // =========================================================================
    match /ratings/{ratingId} {
      allow get: if isValidId(ratingId) && existing().stars >= 1 && existing().stars <= 5;
      allow list: if resource.data.stars >= 1;

      allow create: if isVerifiedUser() &&
        isValidId(ratingId) &&
        isValidRatingRecord(incoming()) &&
        incoming().ratingId == ratingId &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/comics/$(incoming().comicId)) &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isValidRatingRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(ratingId) &&
        incoming().ratingId == existing().ratingId &&
        incoming().comicId == existing().comicId &&
        incoming().episodeId == existing().episodeId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(existing().userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['stars', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['stars', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(ratingId) && (isOwner(existing().userId) || isAdmin());
    }

    // =========================================================================
    // 7. /votes/{voteId}
    // =========================================================================
    match /votes/{voteId} {
      allow get: if isVerifiedUser() && isValidId(voteId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(voteId) &&
        isValidVoteRecord(incoming()) &&
        incoming().voteId == voteId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/comics/$(incoming().comicId)) &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isValidVoteRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(voteId) &&
        incoming().voteId == existing().voteId &&
        incoming().comicId == existing().comicId &&
        incoming().episodeId == existing().episodeId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(existing().userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['voteType', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['voteType', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(voteId) && (isOwner(existing().userId) || isAdmin());
    }

    // =========================================================================
    // 8. /purchases/{purchaseId}
    // =========================================================================
    match /purchases/{purchaseId} {
      allow get: if isVerifiedUser() && isValidId(purchaseId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(purchaseId) &&
        isValidPurchaseRecord(incoming()) &&
        incoming().purchaseId == purchaseId &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        incoming().status == 'success' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isValidPurchaseRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(purchaseId) &&
        incoming().purchaseId == existing().purchaseId &&
        incoming().userId == existing().userId &&
        incoming().comicId == existing().comicId &&
        incoming().amountInr == existing().amountInr &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isAdmin() &&
            existing().status == 'success' &&
            incoming().status == 'refunded' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(purchaseId) && isAdmin();
    }

    // =========================================================================
    // 9. /notifications/{notificationId}
    // =========================================================================
    match /notifications/{notificationId} {
      allow get: if isVerifiedUser() && isValidId(notificationId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotificationRecord(incoming()) &&
        incoming().notificationId == notificationId &&
        incoming().read == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isValidNotificationRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(notificationId) &&
        incoming().notificationId == existing().notificationId &&
        incoming().userId == existing().userId &&
        incoming().type == existing().type &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(existing().userId) &&
            incoming().read == true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['read', 'title', 'message', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(notificationId) && (isOwner(existing().userId) || isAdmin());
    }

    // =========================================================================
    // 10. /authorApplications/{applicationId}
    // =========================================================================
    match /authorApplications/{applicationId} {
      allow get: if isVerifiedUser() && isValidId(applicationId) && (isOwner(existing().userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(applicationId) &&
        isValidAuthorApplicationRecord(incoming()) &&
        incoming().applicationId == applicationId &&
        (incoming().userId == request.auth.uid || isAdmin()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));

      allow update: if isValidAuthorApplicationRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(applicationId) &&
        incoming().applicationId == existing().applicationId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(existing().userId) &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['penName', 'bio', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'penName', 'bio', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(applicationId) && isAdmin();
    }

    // =========================================================================
    // 11. /deleteRequests/{requestId}
    // =========================================================================
    match /deleteRequests/{requestId} {
      allow get: if isVerifiedUser() && isValidId(requestId) && (isOwner(existing().authorId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.authorId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidDeleteRequestRecord(incoming()) &&
        incoming().requestId == requestId &&
        (incoming().authorId == request.auth.uid || isAdmin()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/comics/$(incoming().comicId));

      allow update: if isValidDeleteRequestRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(requestId) &&
        incoming().requestId == existing().requestId &&
        incoming().comicId == existing().comicId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isOwner(existing().authorId) &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['reason', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reason', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(requestId) && isAdmin();
    }

    // =========================================================================
    // 12. /reports/{reportId}
    // =========================================================================
    match /reports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && (isOwner(existing().reporterId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.reporterId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(reportId) &&
        isValidContentReportRecord(incoming()) &&
        incoming().reportId == reportId &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().reporterId));

      allow update: if isValidContentReportRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(reportId) &&
        incoming().reportId == existing().reportId &&
        incoming().reporterId == existing().reporterId &&
        incoming().targetId == existing().targetId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reason', 'updatedAt']))
        );

      allow delete: if isVerifiedUser() && isValidId(reportId) && isAdmin();
    }

    // =========================================================================
    // 13. /gstSettings/{settingId} (Admin-Managed Business GST Profile)
    // =========================================================================
    match /gstSettings/{settingId} {
      allow get: if isValidId(settingId) && isVerifiedUser();
      allow list: if isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(settingId) &&
        isValidGstSettingsRecord(incoming()) &&
        incoming().settingId == settingId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isValidGstSettingsRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(settingId) &&
        incoming().settingId == existing().settingId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'legalBusinessName', 'tradeName', 'gstin', 'stateCode', 'stateName',
          'registeredAddress', 'invoicePrefix', 'defaultSacCode',
          'applicableGstRate', 'updatedByEmail', 'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(settingId) && isAdmin();
    }

    // =========================================================================
    // 14. /platformSettings/{settingId} (Admin-Managed UPI & Razorpay Config)
    // =========================================================================
    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId) && isVerifiedUser();
      allow list: if isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(settingId) &&
        isValidPlatformSettingsRecord(incoming()) &&
        incoming().settingId == settingId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isValidPlatformSettingsRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(settingId) &&
        incoming().settingId == existing().settingId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'merchantUpiId', 'merchantUpiName', 'razorpay1MonthUrl',
          'razorpay6MonthsUrl', 'updatedByEmail', 'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(settingId) && isAdmin();
    }

    // =========================================================================
    // 15. /adRequests/{requestId} (Company Advertising & Sponsorship Requests)
    // =========================================================================
    match /adRequests/{requestId} {
      allow get: if isVerifiedUser() && isValidId(requestId) && (isOwner(existing().submittedByUserId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.submittedByUserId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(requestId) &&
        isValidAdRequestRecord(incoming()) &&
        incoming().requestId == requestId &&
        (incoming().submittedByUserId == request.auth.uid || isAdmin()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidAdRequestRecord(incoming()) &&
        isVerifiedUser() &&
        isValidId(requestId) &&
        incoming().requestId == existing().requestId &&
        incoming().submittedByUserId == existing().submittedByUserId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isVerifiedUser() && isValidId(requestId) && isAdmin();
    }
  }
}
